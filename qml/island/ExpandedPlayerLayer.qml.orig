import QtQuick
import Quickshell.Hyprland
import IslandBackend
import Qt5Compat.GraphicalEffects
import Quickshell.Services.Mpris
import Quickshell.Io
import "../shared"

Item {
    id: root

    signal controlPressed()

    readonly property var userConfig: UserConfig
    property int mediaWorkspaceId: -1
    property string mediaPlayerName: ""
    property bool showCondition: false
    property string currentArtUrl: ""
    property string currentTrack: ""
    property string currentArtist: ""
    property string timePlayed: "0:00"
    property string timeTotal: "0:00"
    property real trackProgress: 0
    property var activePlayer: null
    property var cavaLevels: []
    
    property string iconFontFamily: userConfig.iconFontFamily
    property string textFontFamily: userConfig.textFontFamily
    property real visualizerPhase: 0
    property var walColors: null
    readonly property string cavaActiveColor: (walColors && walColors.colors && walColors.colors.color4) ? walColors.colors.color4 : "#FFFFFF"
    readonly property string cavaPausedColor: (walColors && walColors.colors && walColors.colors.color5) ? walColors.colors.color5 : "#202020"
    readonly property bool isPlaying: activePlayer && activePlayer.playbackState === MprisPlaybackState.Playing

    Process {
        id: walColorsProc
        stdout: StdioCollector { id: walColorsOut }
        onExited: (exitCode, exitStatus) => {
            if (exitCode !== 0) return
            const text = walColorsOut.text
            if (text && text.length > 0)
                root.walColors = text
        }
    }

    Timer {
        interval: 1000
        repeat: true
        running: true
        onTriggered: {
            walColorsProc.command = ["cat", "/home/userone/.cache/wal/colors.sh"]
            walColorsProc.running = true
        }
    }

   function visualizerLevel(index) {
    if (cavaLevels && cavaLevels.length > 0 && isPlaying) {
        const idx = Math.floor(index * cavaLevels.length / 6)
        const v = cavaLevels[idx] || 0

        return Math.min(1.0, Math.pow(v, 1.4) * 1.2)
    }

    const phase = visualizerPhase + index * 0.78
    const primary = (Math.sin(phase) + 1) * 0.5
    const secondary = (Math.sin(phase * 2 + index * 0.95) + 1) * 0.5

    return 0.05 + primary * 0.35 + secondary * 0.2
}

    function pausedVisualizerLevel(index) {
        const levels = [0.34, 0.58, 0.82, 0.82, 0.58, 0.34]
        return levels[index] || 0.4
    }

    function togglePlayback() {
        if (!activePlayer || !activePlayer.canControl) return
        if (activePlayer.canTogglePlaying) { activePlayer.togglePlaying(); return }
        if (activePlayer.playbackState === MprisPlaybackState.Playing) {
            if (activePlayer.canPause) activePlayer.pause()
            return
        }
        if (activePlayer.canPlay) activePlayer.play()
    }

    anchors.fill: parent
    anchors.margins: 16
    opacity: showCondition ? 1 : 0

    Behavior on opacity {
        SequentialAnimation {
            PauseAnimation { duration: showCondition ? IslandMotion.contentEnterDelay : 0 }
            NumberAnimation {
                duration: showCondition ? IslandMotion.contentEnterDuration : IslandMotion.contentExitDuration
                easing.type: showCondition ? IslandMotion.easeMove : IslandMotion.easeOut
            }
        }
    }

    Timer {
        interval: 64
        repeat: true
        running: showCondition && isPlaying
        onTriggered: {
            visualizerPhase += 0.18
            if (visualizerPhase > Math.PI * 2) visualizerPhase -= Math.PI * 2
        }
    }

    // Main strip:  [disc] [title / artist / scrub bar]   [shuffle prev play next loop] [time] | [cava]
    //                                                      "Playing in <player> (Workspace N)"
    Item {
        id: playerRow
        anchors.fill: parent

        // ── round spinning disc ─────────────────────────────────────────────
        Item {
            id: disc
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: Math.min(parent.height, 124)
            height: width

            Image {
                id: expandedArtImage
                anchors.fill: parent
                source: currentArtUrl
                fillMode: Image.PreserveAspectCrop
                sourceSize: Qt.size(300, 300)
                smooth: true
                mipmap: true
                visible: false
            }

            Rectangle {
                id: expandedArtMask
                anchors.fill: parent
                radius: width / 2
                visible: false
            }

            Item {
                id: artSpinner
                anchors.fill: parent

                property real angle: 0

                RotationAnimation on angle {
                    id: spinAnim
                    from: 0
                    to: 360
                    duration: 8000
                    direction: RotationAnimation.Clockwise
                    loops: Animation.Infinite
                    running: isPlaying && currentArtUrl !== ""
                    paused: !isPlaying
                }

                Behavior on angle {
                    enabled: false
                }

                Rectangle {
                    anchors.fill: parent
                    radius: width / 2
                    color: Qt.rgba(1, 1, 1, 0.06)
                    visible: currentArtUrl === ""
                }

                Text {
                    anchors.centerIn: parent
                    visible: currentArtUrl === ""
                    text: ""
                    font.family: iconFontFamily
                    font.pixelSize: 34
                    color: "white"
                    opacity: 0.4
                    renderType: Text.NativeRendering
                }

                OpacityMask {
                    anchors.fill: parent
                    rotation: artSpinner.angle
                    source: expandedArtImage
                    maskSource: expandedArtMask
                }
            }

            // darken when paused
            Rectangle {
                anchors.fill: parent
                radius: width / 2
                color: "black"
                opacity: isPlaying ? 0 : 0.40
                Behavior on opacity { NumberAnimation { duration: 300 } }
            }

            // ring: pulses while playing, plain border when paused
            Rectangle {
                anchors.fill: parent
                radius: width / 2
                color: "transparent"
                border.width: isPlaying ? 2 : IslandMotion.surfaceBorderWidth
                border.color: isPlaying ? Qt.rgba(1, 1, 1, 0.55) : IslandMotion.surfaceBorderColor
                SequentialAnimation on border.color {
                    running: isPlaying && root.showCondition
                    loops: Animation.Infinite
                    ColorAnimation { to: Qt.rgba(1, 1, 1, 0.85); duration: 700; easing.type: Easing.InOutSine }
                    ColorAnimation { to: Qt.rgba(1, 1, 1, 0.20); duration: 700; easing.type: Easing.InOutSine }
                }
            }
        }

        // ── cava bars, far right ─────────────────────────────────────────────
        Item {
            id: cavaBox
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            width: 44
            height: 44

            Row {
                anchors.centerIn: parent
                height: parent.height
                spacing: 4

                Repeater {
                    model: 6
                    delegate: Rectangle {
                        width: 4
                        smooth: true
                        antialiasing: true
                        readonly property real level: root.visualizerLevel(index)
                        height: isPlaying
                            ? 2 + (parent.height - 2) * level
                            : 2 + (parent.height - 2) * pausedVisualizerLevel(index)
                        radius: 2
                        color: isPlaying ? cavaActiveColor : cavaPausedColor
                        anchors.verticalCenter: parent.verticalCenter
                        Behavior on height { NumberAnimation { duration: isPlaying ? 50 : 260; easing.type: Easing.InOutQuad } }
                        Behavior on color { ColorAnimation { duration: isPlaying ? 140 : 280; easing.type: Easing.InOutQuad } }
                    }
                }
            }
        }

        // ── divider before the cava ──────────────────────────────────────────
        Rectangle {
            id: divider
            anchors.right: cavaBox.left
            anchors.rightMargin: 12
            anchors.verticalCenter: parent.verticalCenter
            width: 1
            height: 44
            color: IslandMotion.surfaceBorderColor
        }

        // ── divider between title block and playback controls ────────────────
        Rectangle {
            id: dividerLeft
            anchors.right: controlsBlock.left
            anchors.rightMargin: 12
            anchors.verticalCenter: parent.verticalCenter
            width: 1
            height: 44
            color: IslandMotion.surfaceBorderColor
        }

        // ── transport controls with the "Playing in…" line underneath ─────────
        Item {
            id: controlsBlock
            anchors.right: divider.left
            anchors.rightMargin: 12
            anchors.verticalCenter: parent.verticalCenter
            width: Math.max(topRow.width, statusText.visible ? statusText.implicitWidth : 0)
            height: topRow.height + (statusText.visible ? statusText.height + 8 : 0)

            // [shuffle prev play next loop]  elapsed / total
            Row {
              id: topRow
              anchors.top: parent.top
              anchors.horizontalCenter: parent.horizontalCenter
              height: 36
              spacing: 14

            Row {
                id: transportRow
                anchors.verticalCenter: parent.verticalCenter
                height: 36
                spacing: 10

                // shuffle
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 26
                    height: 26
                    opacity: shuffleArea.pressed ? 0.6 : (activePlayer && activePlayer.shuffle ? 1.0 : 0.35)
                    Behavior on opacity { NumberAnimation { duration: 150 } }
                    Canvas {
                        anchors.fill: parent
                        property color fillColor: "white"
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.setTransform(1, 0, 0, 1, 0, 0)
                            ctx.clearRect(0, 0, width, height)
                            ctx.setTransform(width / 24, 0, 0, height / 24, 0, 0)
                            ctx.strokeStyle = fillColor
                            ctx.lineWidth = 2
                            ctx.lineCap = "round"
                            ctx.lineJoin = "round"
                            ctx.beginPath()
                            ctx.moveTo(3, 7); ctx.lineTo(14, 7); ctx.lineTo(21, 17)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(17, 15); ctx.lineTo(21, 17); ctx.lineTo(17, 19)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(3, 17); ctx.lineTo(14, 17); ctx.lineTo(21, 7)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(17, 5); ctx.lineTo(21, 7); ctx.lineTo(17, 9)
                            ctx.stroke()
                        }
                    }
                    MouseArea {
                        id: shuffleArea
                        anchors.fill: parent
                        anchors.margins: -5
                        preventStealing: true
                        onPressed: (mouse) => { controlPressed(); mouse.accepted = true }
                        onClicked: {
                            if (!activePlayer) return
                            const next = activePlayer.shuffle ? "false" : "true"
                            shuffleProc.command = [
                                "dbus-send", "--print-reply",
                                "--dest=" + activePlayer.dbusName,
                                "/org/mpris/MediaPlayer2",
                                "org.freedesktop.DBus.Properties.Set",
                                "string:org.mpris.MediaPlayer2.Player",
                                "string:Shuffle",
                                "variant:boolean:" + next
                            ]
                            shuffleProc.running = true
                        }
                    }
                }

                // previous
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 32
                    height: 32
                    Canvas {
                        anchors.fill: parent
                        property color fillColor: prevArea.pressed ? "#888" : "white"
                        onFillColorChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.setTransform(1, 0, 0, 1, 0, 0)
                            ctx.clearRect(0, 0, width, height)
                            ctx.setTransform(width / 28, 0, 0, height / 28, 0, 0)
                            ctx.fillStyle = fillColor
                            ctx.strokeStyle = fillColor
                            ctx.lineJoin = "round"
                            ctx.lineWidth = 2
                            ctx.beginPath()
                            ctx.rect(3, 5, 3, 18)
                            ctx.moveTo(14, 5); ctx.lineTo(6, 14); ctx.lineTo(14, 23)
                            ctx.closePath()
                            ctx.moveTo(23, 5); ctx.lineTo(15, 14); ctx.lineTo(23, 23)
                            ctx.closePath()
                            ctx.fill()
                            ctx.stroke()
                        }
                    }
                    MouseArea {
                        id: prevArea
                        anchors.fill: parent
                        anchors.margins: -5
                        preventStealing: true
                        onPressed: (mouse) => { controlPressed(); mouse.accepted = true }
                        onClicked: if (activePlayer) activePlayer.previous()
                    }
                }

                // play / pause
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 34
                    height: 34
                    Row {
                        anchors.centerIn: parent
                        spacing: 7
                        visible: activePlayer && activePlayer.playbackState === MprisPlaybackState.Playing
                        Rectangle { width: 7; height: 23; radius: 3; color: playArea.pressed ? "#888" : "white" }
                        Rectangle { width: 7; height: 23; radius: 3; color: playArea.pressed ? "#888" : "white" }
                    }
                    Canvas {
                        anchors.fill: parent
                        visible: !activePlayer || activePlayer.playbackState !== MprisPlaybackState.Playing
                        property color fillColor: playArea.pressed ? "#888" : "white"
                        onFillColorChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.setTransform(1, 0, 0, 1, 0, 0)
                            ctx.clearRect(0, 0, width, height)
                            ctx.setTransform(width / 28, 0, 0, height / 28, 0, 0)
                            ctx.fillStyle = fillColor
                            ctx.strokeStyle = fillColor
                            ctx.lineJoin = "round"
                            ctx.lineWidth = 2
                            ctx.beginPath()
                            ctx.moveTo(8, 4); ctx.lineTo(24, 14); ctx.lineTo(8, 24)
                            ctx.closePath()
                            ctx.fill()
                            ctx.stroke()
                        }
                    }
                    MouseArea {
                        id: playArea
                        anchors.fill: parent
                        anchors.margins: -5
                        preventStealing: true
                        onPressed: (mouse) => { controlPressed(); mouse.accepted = true }
                        onClicked: togglePlayback()
                    }
                }

                // next
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 32
                    height: 32
                    Canvas {
                        anchors.fill: parent
                        property color fillColor: nextArea.pressed ? "#888" : "white"
                        onFillColorChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.setTransform(1, 0, 0, 1, 0, 0)
                            ctx.clearRect(0, 0, width, height)
                            ctx.setTransform(width / 28, 0, 0, height / 28, 0, 0)
                            ctx.fillStyle = fillColor
                            ctx.strokeStyle = fillColor
                            ctx.lineJoin = "round"
                            ctx.lineWidth = 2
                            ctx.beginPath()
                            ctx.moveTo(5, 5); ctx.lineTo(13, 14); ctx.lineTo(5, 23)
                            ctx.closePath()
                            ctx.moveTo(14, 5); ctx.lineTo(22, 14); ctx.lineTo(14, 23)
                            ctx.closePath()
                            ctx.rect(22, 5, 3, 18)
                            ctx.fill()
                            ctx.stroke()
                        }
                    }
                    MouseArea {
                        id: nextArea
                        anchors.fill: parent
                        anchors.margins: -5
                        preventStealing: true
                        onPressed: (mouse) => { controlPressed(); mouse.accepted = true }
                        onClicked: if (activePlayer) activePlayer.next()
                    }
                }

                // loop (off / playlist / single track)
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 26
                    height: 26
                    opacity: loopArea.pressed ? 0.6 : (activePlayer && activePlayer.loopState !== MprisLoopState.None ? 1.0 : 0.35)
                    Behavior on opacity { NumberAnimation { duration: 150 } }
                    Canvas {
                        anchors.fill: parent
                        property color fillColor: "white"
                        property bool loopOne: activePlayer && activePlayer.loopState === MprisLoopState.Track
                        onLoopOneChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.setTransform(1, 0, 0, 1, 0, 0)
                            ctx.clearRect(0, 0, width, height)
                            ctx.setTransform(width / 24, 0, 0, height / 24, 0, 0)
                            ctx.strokeStyle = fillColor
                            ctx.lineWidth = 2
                            ctx.lineCap = "round"
                            ctx.lineJoin = "round"
                            ctx.beginPath()
                            ctx.moveTo(4, 10); ctx.lineTo(4, 17); ctx.lineTo(18, 17)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(20, 14); ctx.lineTo(18, 17); ctx.lineTo(20, 20)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(20, 14); ctx.lineTo(20, 7); ctx.lineTo(6, 7)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(4, 10); ctx.lineTo(6, 7); ctx.lineTo(4, 4)
                            ctx.stroke()
                            if (loopOne) {
                                ctx.font = "bold 8px sans-serif"
                                ctx.fillStyle = fillColor
                                ctx.textAlign = "center"
                                ctx.fillText("1", 12, 15)
                            }
                        }
                    }
                    MouseArea {
                        id: loopArea
                        anchors.fill: parent
                        anchors.margins: -5
                        preventStealing: true
                        onPressed: (mouse) => { controlPressed(); mouse.accepted = true }
                        onClicked: {
                            if (!activePlayer) return
                            const s = activePlayer.loopState
                            let next
                            if (s === MprisLoopState.None) next = MprisLoopState.Playlist
                            else if (s === MprisLoopState.Playlist) next = MprisLoopState.Track
                            else next = MprisLoopState.None

                            activePlayer.loopState = next
                        }
                    }
                }
            }

                Text {
                    id: timeText
                    renderType: Text.NativeRendering
                    anchors.verticalCenter: parent.verticalCenter
                    width: Math.max(72, implicitWidth)
                    horizontalAlignment: Text.AlignHCenter
                    text: timePlayed + " / " + timeTotal
                    color: IslandMotion.textSecondary
                    font.pixelSize: 14
                    font.family: textFontFamily
                    font.weight: Font.Medium
                }
            }

            // "Playing in <player> (Workspace N)", centred in the controls section
            Text {
                id: statusText
                renderType: Text.NativeRendering
                anchors.top: topRow.bottom
                anchors.topMargin: 8
                anchors.horizontalCenter: parent.horizontalCenter
                width: implicitWidth
                horizontalAlignment: Text.AlignHCenter
                visible: root.mediaWorkspaceId >= 1 && root.activePlayer !== null
                text: {
                    const id = root.activePlayer ? String(root.activePlayer.identity || "").toLowerCase() : ""
                    const name = (id.indexOf("ytm") >= 0 || id.indexOf("youtube") >= 0)
                        ? "YouTube Music"
                        : (root.activePlayer ? (root.activePlayer.identity || "Music") : "Music")
                    return "Playing in " + name + " (Workspace " + root.mediaWorkspaceId + ")"
                }
                color: "#FFFFFF"
                font.pixelSize: 11
                font.weight: Font.Bold
                font.family: textFontFamily
                font.letterSpacing: 0.1
            }
        }

        // ── title / artist / scrub bar ───────────────────────────────────────
        Item {
            id: infoBlock
            anchors.left: disc.right
            anchors.leftMargin: 14
            anchors.right: dividerLeft.left
            anchors.rightMargin: 12
            anchors.verticalCenter: parent.verticalCenter
            height: infoColumn.height

            Column {
                id: infoColumn
                width: parent.width
                spacing: 10

                Item {
                    id: nameBlock
                    width: parent.width
                    height: titleClip.height + artistClip.height + 3

                    // long titles scroll to reveal the end, pause, then slide back
                    Item {
                        id: titleClip
                        width: parent.width
                        height: titleText.height
                        clip: true

                        Text {
                            id: titleText
                            renderType: Text.NativeRendering
                            x: 0
                            readonly property real overflow: Math.max(0, implicitWidth - titleClip.width)
                            text: currentTrack
                            color: "white"
                            font.pixelSize: 19
                            font.family: textFontFamily
                            font.weight: Font.DemiBold
                            font.letterSpacing: -0.2
                            function kick() {
                                titleMarquee.stop(); x = 0
                                if (overflow > 0 && root.showCondition) titleMarquee.start()
                            }
                            onTextChanged: kick()
                            onOverflowChanged: kick()
                            Component.onCompleted: kick()
                            Connections {
                                target: root
                                function onShowConditionChanged() { titleText.kick() }
                            }
                        }

                        SequentialAnimation {
                            id: titleMarquee
                            // plays ONCE (not forever): when the track changes, the title
                            // overflows, or the player opens. Then it rests at the start.
                            loops: 1
                            onRunningChanged: if (!running) titleText.x = 0
                            PauseAnimation { duration: 2500 }
                            NumberAnimation {
                                target: titleText; property: "x"
                                to: -titleText.overflow
                                duration: Math.min(7000, Math.max(900, titleText.overflow * 16))
                                easing.type: Easing.InOutSine
                            }
                            PauseAnimation { duration: 1500 }
                            NumberAnimation {
                                target: titleText; property: "x"
                                to: 0
                                duration: 500
                                easing.type: Easing.InOutSine
                            }
                        }
                    }

                    Item {
                        id: artistClip
                        anchors.top: titleClip.bottom
                        anchors.topMargin: 3
                        width: parent.width
                        height: artistText.height
                        clip: true

                        Text {
                            id: artistText
                            renderType: Text.NativeRendering
                            x: 0
                            readonly property real overflow: Math.max(0, implicitWidth - artistClip.width)
                            text: currentArtist
                            color: IslandMotion.textSecondary
                            font.pixelSize: 14
                            font.family: textFontFamily
                            font.weight: Font.Medium
                            function kick() {
                                artistMarquee.stop(); x = 0
                                if (overflow > 0 && root.showCondition) artistMarquee.start()
                            }
                            onTextChanged: kick()
                            onOverflowChanged: kick()
                            Component.onCompleted: kick()
                            Connections {
                                target: root
                                function onShowConditionChanged() { artistText.kick() }
                            }
                        }

                        SequentialAnimation {
                            id: artistMarquee
                            // plays ONCE (not forever): when the track changes, the title
                            // overflows, or the player opens. Then it rests at the start.
                            loops: 1
                            onRunningChanged: if (!running) artistText.x = 0
                            PauseAnimation { duration: 2500 }
                            NumberAnimation {
                                target: artistText; property: "x"
                                to: -artistText.overflow
                                duration: Math.min(7000, Math.max(900, artistText.overflow * 16))
                                easing.type: Easing.InOutSine
                            }
                            PauseAnimation { duration: 1500 }
                            NumberAnimation {
                                target: artistText; property: "x"
                                to: 0
                                duration: 500
                                easing.type: Easing.InOutSine
                            }
                        }
                    }

                    MouseArea {
                        anchors.fill: parent
                        preventStealing: true
                        onPressed: (mouse) => { mouse.accepted = true }
                        onClicked: (mouse) => {
                            mouse.accepted = true
                            if (activePlayer && activePlayer.canRaise) activePlayer.raise()
                        }
                    }
                }

                Item {
                    width: parent.width
                    height: 12

                    Rectangle {
                        id: progressBar
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width
                        height: 6
                        radius: 3
                        color: "#333333"

                        Rectangle {
                            id: progressFill
                            height: parent.height
                            radius: 3
                            color: "white"
                            width: parent.width * Math.max(0, Math.min(1, trackProgress))
                            Behavior on width {
                                enabled: !scrubArea.pressed
                                NumberAnimation { duration: 500; easing.type: Easing.OutCubic }
                            }
                        }
                        MouseArea {
                            id: scrubArea
                            anchors.fill: parent
                            anchors.margins: -12
                            preventStealing: true
                            onPressed: (mouse) => { mouse.accepted = true; controlPressed() }
                            onClicked: (mouse) => { mouse.accepted = true }
                            onPositionChanged: (mouse) => {
                                if (!pressed) return
                                if (!activePlayer || !activePlayer.canSeek) return
                                const fraction = Math.max(0, Math.min(1, mouse.x / width))
                                const length = Number(activePlayer.length) || 0
                                if (length > 0) activePlayer.position = fraction * length
                            }
                            onReleased: (mouse) => {
                                if (!activePlayer || !activePlayer.canSeek) return
                                const fraction = Math.max(0, Math.min(1, mouse.x / width))
                                const length = Number(activePlayer.length) || 0
                                if (length > 0) activePlayer.position = fraction * length
                            }
                        }
                    }
                }
            }
        }
    }

    Process { id: loopProc }
    Process { id: shuffleProc }
} 
