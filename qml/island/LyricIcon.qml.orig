import QtQuick

// drawn icon (2x canvas shown at 0.5 so it stays crisp); used by the Lyric Control Center
Item {
    id: ico
    property string kind: "note"
    property real   sz: 24
    property color  col: "white"
    width: sz; height: sz
    Canvas {
        anchors.centerIn: parent
        width: ico.sz * 2; height: ico.sz * 2
        scale: 0.5; smooth: true
        property string k: ico.kind
        property color  c: ico.col
        onKChanged: requestPaint()
        onCChanged: requestPaint()
        onPaint: {
            const ctx = getContext("2d")
            ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, width, height)
            ctx.setTransform(width / 24, 0, 0, height / 24, 0, 0)
            ctx.strokeStyle = c; ctx.fillStyle = c
            ctx.lineWidth = 2; ctx.lineCap = "round"; ctx.lineJoin = "round"
            const line = function(p) { ctx.beginPath(); ctx.moveTo(p[0], p[1]); for (let i = 2; i < p.length; i += 2) ctx.lineTo(p[i], p[i + 1]); ctx.stroke() }
            const tri  = function(p) { ctx.beginPath(); ctx.moveTo(p[0], p[1]); for (let i = 2; i < p.length; i += 2) ctx.lineTo(p[i], p[i + 1]); ctx.closePath(); ctx.fill() }
            switch (k) {
            case "note":
                line([9, 18, 9, 5, 19, 3, 19, 16])
                ctx.beginPath(); ctx.arc(6.5, 18, 3, 0, 7); ctx.fill()
                ctx.beginPath(); ctx.arc(16.5, 16, 3, 0, 7); ctx.fill(); break
            case "folder":
                ctx.beginPath(); ctx.moveTo(3, 7); ctx.lineTo(9, 7); ctx.lineTo(11, 9.5); ctx.lineTo(21, 9.5); ctx.lineTo(21, 19); ctx.lineTo(3, 19); ctx.closePath(); ctx.fill(); break
            case "star":
                ctx.beginPath()
                for (let i = 0; i < 10; i++) {
                    const r = i % 2 ? 4.6 : 10, a = -Math.PI / 2 + i * Math.PI / 5
                    const x = 12 + r * Math.cos(a), y = 12.5 + r * Math.sin(a)
                    if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y)
                }
                ctx.closePath(); ctx.fill(); break
            case "sparkle":
                ctx.beginPath(); ctx.moveTo(12, 1); ctx.quadraticCurveTo(12.8, 11.2, 23, 12); ctx.quadraticCurveTo(12.8, 12.8, 12, 23)
                ctx.quadraticCurveTo(11.2, 12.8, 1, 12); ctx.quadraticCurveTo(11.2, 11.2, 12, 1); ctx.fill(); break
            case "search":
                ctx.beginPath(); ctx.arc(10.5, 10.5, 6.5, 0, 7); ctx.stroke(); line([15.5, 15.5, 21, 21]); break
            case "trash":
                line([4, 7, 20, 7]); line([9, 7, 9, 4, 15, 4, 15, 7])
                ctx.beginPath(); ctx.moveTo(6, 7); ctx.lineTo(7, 20); ctx.lineTo(17, 20); ctx.lineTo(18, 7); ctx.stroke()
                line([10, 11, 10, 17]); line([14, 11, 14, 17]); break
            case "doc":
                ctx.beginPath(); ctx.moveTo(5, 2); ctx.lineTo(14, 2); ctx.lineTo(20, 8); ctx.lineTo(20, 22); ctx.lineTo(5, 22); ctx.closePath(); ctx.fill()
                ctx.strokeStyle = "#101a18"; line([8.5, 13, 16.5, 13]); line([8.5, 17, 16.5, 17]); break
            case "filequestion":
                ctx.beginPath(); ctx.moveTo(4, 2); ctx.lineTo(14, 2); ctx.lineTo(20, 8); ctx.lineTo(20, 22); ctx.lineTo(4, 22); ctx.closePath(); ctx.stroke()
                ctx.font = "bold 12px sans-serif"; ctx.textAlign = "center"; ctx.fillText("?", 12, 17); break
            case "shuffle":
                line([3, 7, 14, 7, 21, 17]); line([17, 15, 21, 17, 17, 19]); line([3, 17, 14, 17, 21, 7]); line([17, 5, 21, 7, 17, 9]); break
            case "loop":
                line([4, 10, 4, 17, 18, 17]); line([20, 14, 18, 17, 20, 20]); line([20, 14, 20, 7, 6, 7]); line([4, 10, 6, 7, 4, 4]); break
            case "loopone":
                line([4, 10, 4, 17, 18, 17]); line([20, 14, 18, 17, 20, 20]); line([20, 14, 20, 7, 6, 7]); line([4, 10, 6, 7, 4, 4])
                ctx.font = "bold 8px sans-serif"; ctx.textAlign = "center"; ctx.fillText("1", 12, 15); break
            case "prev":
                ctx.fillRect(3, 5, 3, 14); tri([15, 5, 7, 12, 15, 19]); tri([23, 5, 15, 12, 23, 19]); break
            case "next":
                ctx.fillRect(18, 5, 3, 14); tri([1, 5, 9, 12, 1, 19]); tri([10, 5, 18, 12, 10, 19]); break
            case "play":
                tri([7, 3, 21, 12, 7, 21]); break
            }
        }
    }
}
