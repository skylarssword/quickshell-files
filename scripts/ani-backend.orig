#!/bin/sh
# ani-backend: non-interactive backend for the Quickshell AnimeHub.
# Scraping functions are copied verbatim from ani-cli (pystardust/ani-cli).
# If ani-cli changes how it scrapes, re-sync the functions marked below.
#
#   ani-backend search <query>                  -> id<TAB>title per line
#   ani-backend episodes <id>                   -> one episode number per line
#   ani-backend play <id> <ep> <sub|dub> <title> -> launches the player, prints OK
#   ani-backend history                         -> ep<TAB>id<TAB>title, most recent first
#   ani-backend resume                          -> id<TAB>ep<TAB>seconds for saved spots ("c" in mpv)
#   ani-backend delete <id>                     -> removes one anime from history, prints OK
#   ani-backend clear                           -> wipes the whole history, prints OK
#   ani-backend version                         -> ok|outdated|unknown, tab separated versions
#
# Errors go to stderr as "ERR<TAB>message" with exit code 1.

base_api="https://hianime.at"
search_api="${base_api}/search?keyword=%s"
episodes_api="${base_api}/api/theme/episode/list/%s"
servers_api="${base_api}/api/theme/episode/servers?episodeId=%s"
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
quality="${ANI_CLI_QUALITY:-best}"
player_extra_flags="${ANI_CLI_PLAYER_FLAGS:-}"
hist_dir="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli}"
histfile="$hist_dir/ani-hsts"
resume_dir="$hist_dir/resume"
self_dir="$(cd "$(dirname "$0")" && pwd)"
ANI_BACKEND_SELF="$self_dir/ani-backend"
export ANI_BACKEND_SELF
cipher_flag=""

die() {
    printf 'ERR\t%s\n' "$*" >&2
    exit 1
}

# ---- copied from ani-cli ----
dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

hianime_curl() {
    _curl_status=0
    _response="$($curl_exe -sL -A "$agent" --max-time 10 $cipher_flag \
        -w ' %{http_code}' "$@")" || _curl_status=$?

    _http_code=${_response##* }
    _response=${_response% *}

    if [ "$_curl_status" -ne 0 ]; then
        case "$_http_code" in
            [1-5][0-9][0-9]) _detail="HTTP $_http_code" ;;
            *) _detail="no HTTP response" ;;
        esac
        die "Connection error: could not fetch $1 ($_detail; curl exit $_curl_status)"
    fi

    case "$_http_code" in
        2??) ;;
        *) printf "%s" "$_response" | grep -qi "Just a moment" ||
            die "Request failed: HTTP $_http_code from $1" ;;
    esac

    printf "%s" "$_response"
}

b64_decode() {
    printf "%s\n" "$1" | base64 -d 2>/dev/null || printf "%s\n" "$1" | base64 -D 2>/dev/null || printf "%s\n" "$1" | openssl base64 -d -A 2>/dev/null
}

deobfuscate_blob() (
    _bytes="$(b64_decode "$1" | od -v -An -tu1)"
    set -- 111 116 97 107 117 45 101 109 98 101 100 45 118 49
    _output=""
    for _byte in $_bytes; do
        _char=$((_byte ^ $1))
        _output="${_output}\\0$((_char / 64))$(((_char / 8) % 8))$((_char % 8))"
        set -- "$@" "$1"
        shift
    done
    printf "%b" "$_output"
)

hianime_search() {
    #shellcheck disable=SC2059
    _page="$(hianime_curl "$(printf "$search_api" "$1")")" || return 1
    if printf "%s" "$_page" | grep -qi "<title>Just a moment"; then
        [ "$curl_exe" = "curl" ] && die "Blocked by cloudflare. Try installing curl-impersonate"
        die "Blocked by cloudflare."
    fi
    # the top 10 sidebar repeats the result markup, cut it off before flattening the page
    printf "%s" "$_page" | sed '/id="main-sidebar"/,$d' | tr '\n' ' ' | sed 's|<div class="film-detail">|\n<div class="film-detail">|g' |
        sed -nE 's|.*<h3 class="film-name">[[:space:]]*<a href="[^"]*/([^"/]*)"[[:space:]]*title="([^"]*)".*|\1\t\2|p' |
        sed -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e "s|&amp;|\&|g"
}

hianime_episodes() {
    #shellcheck disable=SC2059
    _page="$(hianime_curl "$(printf "$episodes_api" "${1##*-}")")" || return 1
    # ids from the v5.0 provider have the same shape, so check the slug in the episode links too
    printf "%s" "$_page" | sed 's|\\||g; s|ep-item|\nep-item|g' |
        sed -nE "s|.*data-number=\"([^\"]*)\".*data-id=\"([0-9]+)\".*/watch/${1}[?]ep=.*|\\2\\t\\1|p"
}

hianime_m3u8() {
    _ep_id=$(printf "%s" "$episode_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    #shellcheck disable=SC2059
    _servers="$(hianime_curl "$(printf "$servers_api" "$_ep_id")" | sed 's|\\"|"|g; s|server-item|\nserver-item|g')"
    # only the zokoanime embed is understood by deobfuscate_blob, the other servers use different players
    _hash="$(printf "%s\n" "$_servers" | sed -nE 's|.*data-type="'"$2"'".*data-server-name="ZokoAnime".*data-hash="([^"]*)".*|\1|p' | head -n 1)"
    _embed="$(b64_decode "$_hash")"
    [ -z "$_embed" ] && return 1
    # the stream host wants the embed site as referer, and the embed url carries the mal id for ani-skip
    refr="$(printf "%s" "$_embed" | sed -E 's|^(https?://[^/]*).*|\1/|')"
    mal_id="$(printf "%s" "$_embed" | sed -nE 's|.*/mal/([0-9]+)/.*|\1|p')"
    _blob="$(hianime_curl "$_embed" | sed -nE 's|.*window\.__P="([^"]*)".*|\1|p')"
    [ -z "$_blob" ] && return 1
    _json="$(deobfuscate_blob "$_blob")"
    _m3u8_master="$(printf "%s" "$_json" | sed -nE 's|.*"src":"([^"]*\.m3u8[^"]*)".*|\1|p')"
    [ -z "$_m3u8_master" ] && return 1
    sub_link="$(printf "%s" "$_json" | sed 's|.*"subtitles":\[||; s|}\].*||; s|},{|}\n{|g' | grep -m 1 '"default":true' | sed -nE 's|.*"src":"([^"]*)".*|\1|p')"
    _playlist="$(hianime_curl "$_m3u8_master" -e "$refr")"
    # quality variants are relative to the master playlist
    links="$(printf "%s\n" "$_playlist" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' | sed "\|>https*://|!s|>|>${_m3u8_master%/*}/|" | sort -g -r -s)"
    audio_link="$(printf "%s\n" "$_playlist" | sed -nE '/^#EXT-X-MEDIA:TYPE=AUDIO,.*DEFAULT=YES/{s|.*URI="([^"]*)".*|\1|p;q;}' | sed "\|^https*://|!s|^|${_m3u8_master%/*}/|")"
    [ -n "$links" ]
}

select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    video_link=$(printf "%s" "$_result" | cut -d ">" -f 2)
}

update_history() {
    if grep -q "	${anime_id}	" "$histfile"; then
        # escape sed special chars in replacement: & and \ and delimiter |
        safe_title=$(printf "%s" "$anime_title" | sed 's|[&\|]|\\&|g')
        sed -E "s|^[^	]+	${anime_id}	[^	]+$|${ep_no}	${anime_id}	${safe_title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

# ---- end of copied functions ----

curl_exe=$(dep_ch_failover "curl_firefox135,curl_chrome136,curl_chrome116,curl_ff117,curl") || die "curl not found"
mkdir -p "$hist_dir" && [ -f "$histfile" ] || : >"$histfile"

# ani-cli keeps history in file order; move the entry just played to the end so
# the last line is always the most recently watched.
bump_history() {
    _keep="$(awk -F '\t' -v id="$anime_id" '$2 != id' "$histfile")"
    _mine="$(awk -F '\t' -v id="$anime_id" '$2 == id' "$histfile" | tail -n 1)"
    [ -z "$_mine" ] && return 0
    {
        [ -n "$_keep" ] && printf '%s\n' "$_keep"
        printf '%s\n' "$_mine"
    } >"${histfile}.new" && mv "${histfile}.new" "$histfile"
}

cmd_search() {
    _q="$(printf '%s' "$*" | sed 's|^ *||; s| *$||; s| |+|g')"
    [ -z "$_q" ] && exit 0
    _list="$(hianime_search "$_q")" || exit 1
    [ -n "$_list" ] && printf '%s\n' "$_list"
    exit 0
}

cmd_episodes() {
    [ -z "$1" ] && die "missing anime id"
    _maps="$(hianime_episodes "$1")" || exit 1
    [ -z "$_maps" ] && die "No episodes found. The site layout may have changed."
    printf '%s\n' "$_maps" | cut -f 2
}

cmd_play() {
    anime_id="$1"
    ep_no="$2"
    mode="${3:-sub}"
    anime_title="$4"
    [ -z "$anime_id" ] || [ -z "$ep_no" ] && die "missing anime id or episode"

    episode_maps="$(hianime_episodes "$anime_id")" || exit 1
    [ -z "$episode_maps" ] && die "No episodes found. The site layout may have changed."
    printf '%s\n' "$episode_maps" | cut -f 2 | grep -qxF -- "$ep_no" || die "Episode $ep_no not found"

    hianime_m3u8 "$ep_no" "$mode" || die "No $mode stream found. The site or ani-cli may have changed."
    select_quality "$quality"
    [ -z "$video_link" ] && die "Episode is listed but has no playable stream"

    player="${ANI_CLI_PLAYER:-mpv}"
    command -v "$player" >/dev/null 2>&1 || die "Player '$player' not found"

    # Resume: pick up a saved spot for this episode (written when you press "c"
    # in mpv), then clear it. Playing anything else drops it.
    mkdir -p "$resume_dir"
    resume_start=""
    if [ -f "$resume_dir/$anime_id" ]; then
        IFS="$(printf '\t')" read -r _rep _rpos <"$resume_dir/$anime_id"
        [ "$_rep" = "$ep_no" ] && [ -n "$_rpos" ] && resume_start="$_rpos"
        rm -f "$resume_dir/$anime_id"
    fi

    set -- --referrer="$refr"
    [ -n "$audio_link" ] && set -- "$@" --audio-file="$audio_link"
    [ -n "$sub_link" ] && set -- "$@" --sub-file="$sub_link"
    case "$(basename "$player")" in
        mpv*)
            [ -f "$self_dir/ani_resume.lua" ] && set -- "$@" --script="$self_dir/ani_resume.lua" \
                --script-opts="ani_resume-dir=$resume_dir,ani_resume-id=$anime_id,ani_resume-ep=$ep_no"
            [ -n "$resume_start" ] && set -- "$@" --start="$resume_start"
            ;;
    esac
    # shellcheck disable=SC2086
    set -- "$@" $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"

    # Run the player detached, then ask the shell to reopen the anime hub once
    # it exits. Set ANI_BACKEND_NO_REOPEN=1 to turn the reopen off.
    # shellcheck disable=SC2016
            _wrap='"$@" >/dev/null 2>&1 </dev/null
[ -n "$ANI_BACKEND_NO_REOPEN" ] || sh "$ANI_BACKEND_SELF" reopen >/dev/null 2>&1'
    if command -v setsid >/dev/null 2>&1; then
        setsid -f nohup sh -c "$_wrap" sh "$player" "$@" >/dev/null 2>&1
    else
        nohup sh -c "$_wrap" sh "$player" "$@" >/dev/null 2>&1 &
    fi

    update_history
    bump_history
    printf 'OK\n'
}

cmd_history() {
    [ -s "$histfile" ] || exit 0
    awk -F '\t' 'NF >= 3 && $2 ~ /-/' "$histfile" | tac
}

# saved spots: id<TAB>ep<TAB>seconds per line
cmd_resume() {
    for _f in "$resume_dir"/*; do
        [ -f "$_f" ] || continue
        printf '%s\t%s\n' "$(basename "$_f")" "$(cat "$_f")"
    done
    exit 0
}

# remove one anime from the history (exact id match, field 2)
cmd_delete() {
    [ -z "$1" ] && die "missing anime id"
    case "$1" in */*) die "bad anime id" ;; esac
    rm -f "$resume_dir/$1"
    _tmp="${histfile}.del.$$"
    awk -F '\t' -v id="$1" '$2 != id' "$histfile" >"$_tmp" && mv "$_tmp" "$histfile"
    printf 'OK\n'
}

cmd_clear() {
    : >"$histfile"
    rm -f "$resume_dir"/* 2>/dev/null
    printf 'OK\n'
}

# reopen the anime hub in whichever mode is active (sidebar or main island)
cmd_reopen() {
    _shell_dir="${ANI_BACKEND_SHELL_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
    _cfg="$HOME/.cache/quickshell/appearance-settings.json"
    if grep -Eq '"sidebarEnabled"[[:space:]]*:[[:space:]]*true' "$_cfg" 2>/dev/null; then
        _target="tide-sidebar"
    else
        _target="tide"
    fi
    qs ipc -p "$_shell_dir" call "$_target" openAnime
}

cmd_version() {
    _bin="${ANI_CLI_PATH:-$(command -v ani-cli 2>/dev/null)}"
    _local=""
    [ -n "$_bin" ] && [ -r "$_bin" ] && _local="$(sed -nE 's|^version_number="([^"]+)"$|\1|p' "$_bin" 2>/dev/null | head -n 1)"
    _cache="${XDG_CACHE_HOME:-$HOME/.cache}/ani-backend-aur-version"
    _remote=""
    [ -n "$(find "$_cache" -mmin -360 2>/dev/null)" ] && _remote="$(cat "$_cache")"
    if [ -z "$_remote" ]; then
        # newest version of the AUR package (override with ANI_BACKEND_AUR_PKG, e.g. ani-cli-git)
        _remote="$(curl -fsSL --max-time 8 "https://aur.archlinux.org/rpc/v5/info/${ANI_BACKEND_AUR_PKG:-ani-cli}" 2>/dev/null |
            sed -nE 's|.*"Version":"([^"]+)".*|\1|p' | sed -E 's|^[0-9]+:||; s|-[0-9]+$||' | head -n 1)"
        [ -n "$_remote" ] && { mkdir -p "$(dirname "$_cache")"; printf '%s\n' "$_remote" >"$_cache"; }
    fi
    if [ -z "$_local" ] || [ -z "$_remote" ]; then
        printf 'unknown\t%s\t%s\n' "$_local" "$_remote"
    elif [ "$_local" = "$_remote" ]; then
        printf 'ok\t%s\n' "$_local"
    elif [ "$(printf '%s\n%s\n' "$_local" "$_remote" | sort -V | head -n 1)" = "$_local" ]; then
        printf 'outdated\t%s\t%s\n' "$_local" "$_remote"
    else
        printf 'ok\t%s\n' "$_local"
    fi
}

case "$1" in
    search) shift; cmd_search "$@" ;;
    episodes) cmd_episodes "$2" ;;
    play) cmd_play "$2" "$3" "$4" "$5" ;;
    history) cmd_history ;;
    delete) cmd_delete "$2" ;;
    resume) cmd_resume ;;
    clear) cmd_clear ;;
    reopen) cmd_reopen ;;
    version) cmd_version ;;
    *) die "usage: ani-backend search|episodes|play|history|resume|delete|clear|version|reopen" ;;
esac
